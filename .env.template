# ============================================================================
# .env — API Keys & Environment Variables
# ============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is listed in .gitignore.
# ============================================================================

# --- LLM Providers ---
# Drafter agent (caption generation). Provider: Anthropic Claude.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Critic agent (QA checks) + Image generation (gpt-image-2). Provider: OpenAI.
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Media Rendering ---
# Creatomate — text overlay + video template rendering.
CREATOMATE_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Publishing ---
# SocialBu — publishing to Facebook, Instagram, GBP.
SOCIALBU_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Notifications ---
# Slack Bot Token — approval cards, error notifications, health reports.
# Required scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Google OAuth ---
# Path to the OAuth client credentials JSON file (downloaded from GCP console).
# Used for: Google Drive, Google Sheets, GBP Performance API, GBP Reviews API.
GOOGLE_CREDENTIALS_PATH=credentials_tes.json

# Path to the OAuth token file (auto-generated on first auth flow).
# Used for: Drive + Sheets access.
GOOGLE_TOKEN_PATH=token_drive.json

# Path to the GBP-specific OAuth token file.
# Used for: GBP Performance API + GBP Reviews API.
GBP_TOKEN_PATH=token_gbp.json

# --- Business Config ---
# Path to the business config YAML file (relative or absolute).
BUSINESS_CONFIG_PATH=business_config.yaml
